# Offline scoring only (scripts/04_score_occupations.ts). Never used by the Next.js UI or /api routes.
OPENAI_API_KEY=
# Optional alias
SCORING_API_KEY=
# Optional model id stored in the SQLite cache key
SCORING_MODEL=gpt-4.1-mini
# Set to 1 to replace fixture scores with LLM scores for the same codes
RESCORE_FIXTURES=0
