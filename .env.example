# Offline catalog scoring (scripts/04_score_occupations.ts). Never used to rescore the occupation database at runtime.
OPENAI_API_KEY=
# Optional alias
SCORING_API_KEY=
# Optional model id stored in the SQLite cache key
SCORING_MODEL=gpt-4.1-mini
# Set to 1 to replace fixture scores with LLM scores for the same codes
RESCORE_FIXTURES=0

# Runtime workday analysis (POST /api/workday/analyze). Server-side only — never sent to the browser.
# Without a key the endpoint returns 503 and the UI shows an error. That is the supported no-key path.
# WORKDAY_DEV_FIXTURE=1 returns a labelled fixture for local/dev only. Never present it as official statistics.
WORKDAY_MODEL=gpt-4.1-mini
WORKDAY_DEV_FIXTURE=0
